POSTGRES_DB=model_serve_mini
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/model_serve_mini

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CPU_TOPIC=training-jobs-cpu
KAFKA_GPU_TOPIC=training-jobs-gpu
KAFKA_COMPLETION_TOPIC=training-job-completed

REDIS_HOST=redis
REDIS_PORT=6379

DATASET_STORAGE_PATH=/app/storage/datasets
MODEL_STORAGE_PATH=/app/storage

# Docker Compose Quick Start에서는 CPU algorithm만 실행
ENABLE_GPU_TRAINING=false